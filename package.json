{
  "name": "codelib2-htmldoc",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "repository": "git@github.com:buyoh/codeLib2-htmldoc.git",
  "author": "mai",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "css-types": "node tools/gen-scss-dts.mjs src",
    "typecheck": "node tools/gen-scss-dts.mjs src && tsc --noEmit -p tsconfig.json",
    "build": "node tools/gen-scss-dts.mjs src && tsc --noEmit -p tsconfig.prod.json && TS_NODE_PROJECT='tsconfig.prod.json' webpack --config webpack.prod.config.js",
    "dev": "pnpm typecheck && webpack serve",
    "lint": "prettier --check 'src/**/*.{ts,tsx}' 'tools/**/*.mjs' && eslint 'src/**/*.{ts,tsx}' 'tools/**/*.mjs'",
    "test": "vitest run",
    "validate-data": "CODELIB_DATA_PATH=public/data/codelib_full.json vitest run tools/validate-data.spec.mjs",
    "lint-fix": "prettier --write 'src/**/*.{ts,tsx}' 'tools/**/*.mjs' && eslint --fix 'src/**/*.{ts,tsx}' 'tools/**/*.mjs'"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "fp-ts": "^2.16.11",
    "io-ts": "^2.2.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.7",
    "css-loader": "^7.1.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "sass": "^1.106.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.7",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "pnpm": ">=12"
  }
}

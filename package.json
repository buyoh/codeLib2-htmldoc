{
  "name": "codelib2-htmldoc",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "repository": "git@github.com:buyoh/codeLib2-htmldoc.git",
  "author": "mai",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.prod.json && TS_NODE_PROJECT='tsconfig.prod.json' webpack --config webpack.prod.config.js",
    "dev": "pnpm typecheck && webpack serve",
    "lint": "prettier --check 'src/**/*.{ts,tsx}' && eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "lint-fix": "prettier --write 'src/**/*.{ts,tsx}' && eslint --fix 'src/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "fp-ts": "^2.16.11",
    "io-ts": "^2.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^7.2.9",
    "react-router": "^7.18.4",
    "redux": "^5.0.1",
    "reselect": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-redux": "^7.1.33",
    "@types/redux": "^3.6.31",
    "css-loader": "^5.2.7",
    "css-modules-typescript-loader": "^4.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "sass": "^1.94.2",
    "sass-loader": "^10.4.1",
    "style-loader": "^2.0.0",
    "ts-loader": "^8.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "webpack": "^5.112.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.7",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "pnpm": ">=12"
  }
}
